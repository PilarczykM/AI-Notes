      "parameters": {
        "inputText": "={{ $json.Subject }}\n{{ $json.snippet }}",
        "categories": {
          "categories": [
            {
              "category": "Personal",
              "description": "Prywatne wiadomości niezwiązane z pracą ani transakcjami. Obejmują komunikację z rodziną, znajomymi lub prywatne sprawy użytkownika, takie jak zaproszenia, gratulacje, potwierdzenia spotkań niezawodowych czy wiadomości od lekarza lub urzędów."
            },
            {
              "category": "Recruitment",
              "description": "Maile zawierające oferty zatrudnienia, propozycje rekrutacyjne lub wiadomości od rekruterów. Mogą pochodzić z platform takich jak LinkedIn, Indeed, Pracuj.pl, czy bezpośrednio od firm i agencji HR. Często zawierają słowa kluczowe takie jak \"oferta pracy\", \"stanowisko\", \"szukamy\", \"rekrutacja\", \"dołącz do zespołu\", itp."
            },
            {
              "category": "Social",
              "description": "Wiadomości pochodzące z mediów społecznościowych i platform komunikacyjnych, takich jak Facebook, Instagram, Twitter/X, TikTok czy LinkedIn (poza ofertami pracy). Obejmują powiadomienia o wiadomościach, komentarzach, oznaczeniach, polubieniach, czy zaproszeniach do znajomych."
            },
            {
              "category": "Rachunki",
              "description": "Wiadomości zawierające faktury, potwierdzenia płatności, przypomnienia o rachunkach i informacje o subskrypcjach. Mogą pochodzić od dostawców usług takich jak energia, internet, telefon, streaming, banki lub sklepy online. Często zawierają słowa typu „faktura”, „rachunek”, „opłata”, „do zapłaty” lub „potwierdzenie płatności”."
            },
            {
              "category": "Spam",
              "description": "Niechciane lub masowe wiadomości, często o charakterze reklamowym, podejrzanym albo automatycznym. Mogą zawierać obietnice szybkiego zysku, podejrzane linki, oferty bez związku z zainteresowaniami użytkownika, a także wiadomości phishingowe. Często wysyłane są z nieznanych lub nietypowych adresów e-mail i mogą być napisane w sposób nienaturalny lub zawierać błędy językowe."
            },
            {
              "category": "Powiadomienia systemowe",
              "description": "Wiadomości wysyłane automatycznie przez systemy, aplikacje lub serwisy internetowe, dotyczące bezpieczeństwa konta, zmian ustawień, logowań, aktualizacji regulaminów lub innych technicznych informacji. Pochodzą zazwyczaj od platform takich jak Google, Apple, Microsoft, banki, dostawcy usług czy systemy chmurowe. Przykłady: potwierdzenie aktywacji 2FA, alert o podejrzanym logowaniu, aktualizacja polityki prywatności."
            }
          ]
        },
        "options": {}
